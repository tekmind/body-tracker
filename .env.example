VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Food tab — server-side only (set these in Vercel, not in the browser bundle).
# USDA FoodData Central powers food search: free key, instant signup at
# https://fdc.nal.usda.gov/api-key-signup.html
# Without it, search still works but falls back to Open Food Facts alone,
# which is weak on generic whole foods.
USDA_API_KEY=your-usda-fdc-key
# Anthropic API key for "say what you ate" voice/text entry. Without it the
# rest of the Food tab works; only that button reports it's switched off.
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional. Nutritionix adds restaurant menu items and grocery brands, which
# USDA barely covers. Free developer tier is 500 requests/day and requires
# showing their attribution (the app does this automatically when their data
# appears). Sign up at https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=your-nutritionix-app-id
NUTRITIONIX_APP_KEY=your-nutritionix-app-key

# Optional. Which model parses spoken meals. Defaults to claude-haiku-4-5,
# the cheapest tier, which is plenty for schema-constrained extraction.
# Set claude-sonnet-5 (or claude-opus-5) if matching quality disappoints.
# FOOD_PARSE_MODEL=claude-haiku-4-5
# Optional. Which model looks up nutrition on the web for custom foods.
# Defaults to claude-sonnet-5 — reading a nutrition panel off an arbitrary
# page needs more judgement than parsing does, and this runs rarely.
# FOOD_LOOKUP_MODEL=claude-sonnet-5
