VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Food tab — server-side only (set these in Vercel, not in the browser bundle).
# USDA FoodData Central powers food search: free key, instant signup at
# https://fdc.nal.usda.gov/api-key-signup.html
# Without it, search still works but falls back to Open Food Facts alone,
# which is weak on generic whole foods.
USDA_API_KEY=your-usda-fdc-key
# Anthropic API key for "say what you ate" voice/text entry. Without it the
# rest of the Food tab works; only that button reports it's switched off.
ANTHROPIC_API_KEY=sk-ant-your-key
